DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.92.141.90
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.92.141.90:3000,http://localhost:3001,http://127.0.0.1:3001
DJANGO_SECURE_SSL_REDIRECT=false
# Supabase Postgres / Session Pooler URL.
# If your password contains special characters, URL-encode it before pasting.
DATABASE_URL=postgresql://postgres.yexvlkjkwptltkqlketk:REPLACE_WITH_SUPABASE_DATABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_ADMIN_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional fallback EmailJS account/service. Used automatically if the primary send fails.
# Leave fallback public/private keys blank only when the fallback service is in the same EmailJS account.
EMAILJS_FALLBACK_SERVICE_ID=service_8zwd1lx
EMAILJS_FALLBACK_TEMPLATE_ID=template_3xto7rg
EMAILJS_FALLBACK_ADMIN_TEMPLATE_ID=template_an1idui
EMAILJS_FALLBACK_PUBLIC_KEY=
EMAILJS_FALLBACK_PRIVATE_KEY=
# Manual payment rejection email. Blank keys reuse EMAILJS_PUBLIC_KEY / EMAILJS_PRIVATE_KEY.
EMAILJS_REJECTION_SERVICE_ID=service_wezwdbh
EMAILJS_REJECTION_TEMPLATE_ID=template_jpcl8ed
EMAILJS_REJECTION_PUBLIC_KEY=
EMAILJS_REJECTION_PRIVATE_KEY=
EMAILJS_FALLBACK_REJECTION_SERVICE_ID=
EMAILJS_FALLBACK_REJECTION_TEMPLATE_ID=
EMAILJS_FALLBACK_REJECTION_PUBLIC_KEY=
EMAILJS_FALLBACK_REJECTION_PRIVATE_KEY=
ADMIN_NOTIFICATION_EMAIL=
BACKBLAZE_B2_ENABLED=true
# Use the exact S3-compatible bucket details from Backblaze.
# BACKBLAZE_B2_KEY_ID is the application key ID, not the key name.
# BACKBLAZE_B2_APPLICATION_KEY is the application key secret shown once by Backblaze.
# BACKBLAZE_B2_ENDPOINT_URL example: https://s3.us-west-004.backblazeb2.com
# BACKBLAZE_B2_REGION example: us-west-004
BACKBLAZE_B2_BUCKET_NAME=
BACKBLAZE_B2_KEY_ID=
BACKBLAZE_B2_APPLICATION_KEY=
BACKBLAZE_B2_ENDPOINT_URL=
BACKBLAZE_B2_REGION=
BACKBLAZE_B2_CUSTOM_DOMAIN=
BACKBLAZE_B2_ADDRESSING_STYLE=path
